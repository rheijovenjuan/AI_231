# Dataset (large; re-download with train.py --download)
data/
samples/
!samples/.gitkeep

# Generated
music/*
!music/.gitkeep
__pycache__/
*.pyc
.venv/
venv/

# Large local datasets (the optionB dataset lives in the course repo)
*.log
# Training logs under output/training/ are submission evidence - track them
!output/training/logs/*.log
.cache/

